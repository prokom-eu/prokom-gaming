# prokom-web — environment variables (template).
# Copy to .env and fill in. Never commit .env. Real values live in the password manager
# (entry "prokom-web .env lokalny"). Validation: src/lib/env.ts — the app will not start
# if a required variable is missing or invalid.

# Runtime mode: development | test | production. Next.js sets it automatically for
# `pnpm dev` / `pnpm build`; usually leave it unset locally.
# NODE_ENV=development

# PostgreSQL connection string (required). The default matches docker/compose.dev.yml.
DATABASE_URL=postgresql://prokom:prokom@127.0.0.1:54320/prokom_web

# Secret used by Payload to sign tokens and encrypt data (required, at least 32 characters).
# Different value per environment. Generate one, e.g. in PowerShell:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Port of `pnpm dev` and the e2e tests in this working folder (optional, default 3000).
# Two sites in parallel = two folders (git worktree), each with its own port and database:
# second folder → PORT=3001 and DATABASE_URL ending in /prokom_web_software (docs/sposob-pracy.md).
# PORT=3000

# Domain of the admin panel (required): `/admin` and the Payload API respond only on this host,
# every other domain gets 404 there (ADR-006). Hostname only, without scheme or port.
# Local: panel.localhost (open http://panel.localhost:3000/admin). Production: panel.pro-kom.eu.
PANEL_HOST=panel.localhost

# Local admin created by `pnpm seed` (local development only; the seed refuses to run when
# NODE_ENV=production). Optional for the app itself — required only by the seed.
# Password: at least 12 characters. Keep the same values on both computers (password manager).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Optional: at most this many katalog v2 gallery photos per product (whole number from 1).
# CI sets 2 to seed faster; leave empty locally (whole gallery). Careful: set on a database with
# full galleries, it cuts the `images` of those products to 2 (the photos stay in Media). The
# next `pnpm seed:biznes` without the limit restores them.
SEED_GALLERY_LIMIT=

# Directory for uploaded files (optional, default: media — relative to the app directory,
# already in .gitignore). Each upload collection gets a subfolder (media/, partners/).
# On the server: a Docker volume mounted e.g. at /app/media (S9). Backups include it.
# MEDIA_DIR=media

# Deployment kind (optional, default: local): production | staging | local.
# staging → every page gets noindex and robots.txt disallows everything (the staging server
# is also behind a password, S10). local → addresses in canonical/sitemap use http://.
# SITE_ENV=local

# Outgoing mail — inquiry notifications and customer confirmations (ADR-003). Required.
# Local: Mailpit from docker/compose.dev.yml (SMTP 127.0.0.1:1025, no login; mails at
# http://localhost:8025). Server: SMTP of the mail provider (ADR-002, docs/dns.md).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# true = TLS from the first byte (port 465); false (default) = STARTTLS when offered (587).
# SMTP_SECURE=false
# Login to the SMTP server (optional; leave unset for Mailpit). Password manager on the server.
# SMTP_USER=
# SMTP_PASS=

# Sender of every mail (required): an address in a domain with SPF/DKIM/DMARC (docs/dns.md;
# the production address is decided with DNS in S10). Display name optional (default PRO-KOM).
MAIL_FROM_ADDRESS=formularz@example.test
# MAIL_FROM_NAME=PRO-KOM

# Closed inquiries are deleted this many months after their last status change
# (optional, default 24; ADR-003 — confirm with the privacy policy).
# INQUIRY_RETENTION_MONTHS=24

# --- Server only: docker/compose.prod.yml (+ compose.staging.yml). Not read by the app; compose
# reads them from the same file (`docker compose --env-file .env.prod -f docker/compose.prod.yml
# up -d`). Staging: `.env.staging` with SITE_ENV=staging and APP_PORT=3001; compose.staging.yml
# always reads it (docs/wdrozenia.md). ---
# Image to run: the commit SHA tag in ghcr.io/prokom-eu/prokom-web. Rollback = previous SHA.
# APP_IMAGE_TAG=
# Password of the stack's PostgreSQL; DATABASE_URL above must use it and the host `postgres`,
# e.g. postgresql://prokom:<password>@postgres:5432/prokom_prod (staging: prokom_staging)
# POSTGRES_PASSWORD=
# Port on 127.0.0.1 for a smoke test on the server (optional, default 3000; staging 3001).
# Nginx reaches the app over the `prokom-proxy` network, not this port.
# APP_PORT=3000

# --- Proxy (server only): docker/compose.proxy.yml (S9b), file `.env.proxy`. ---
# Domains per stack, space-separated, without scheme. Certificates: one per stack
# (certbot --cert-name prokom-prod / prokom-staging, docs/wdrozenia.md).
# PROD_SITE_HOSTS=prokombiznes.pl prokominstalacje.pl prokomsoftware.pl
# PROD_PANEL_HOST=panel.pro-kom.eu
# STAGING_SITE_HOSTS=staging.prokombiznes.pl staging.prokominstalacje.pl staging.prokomsoftware.pl
# TODO(krystian): staging panel domain (DNS in S10), e.g. panel-staging.pro-kom.eu
# STAGING_PANEL_HOST=
# Password file of staging (htpasswd format) on the server, outside the repo; relative to
# docker/ (compose resolves paths from the compose file), e.g. next to the repo directory.
# STAGING_HTPASSWD_FILE=../../secrets/staging.htpasswd
# Public ports of nginx (optional, default 80 / 443; a local test uses e.g. 18080 / 18443).
# HTTP_PORT=80
# HTTPS_PORT=443
# Certificates: a named volume by default (filled by certbot on the server); a local test
# points it at a directory with self-signed live/prokom-prod/ and live/prokom-staging/.
# LETSENCRYPT_DIR=letsencrypt

# --- Backup (server only): scripts/backup.sh and restore.sh (S9b-2), file `.env.backup`. ---
# Public age key (from `age-keygen`); backups are encrypted with it. The private key lives only
# in the password manager ("prokom-web backup age"), never on the server permanently.
# AGE_RECIPIENT=age1...
# Off-server target (rclone remote:path, configured with `rclone config`). TODO(S10): provider
# other than Seohost (ADR-002).
# RCLONE_REMOTE=offsite:prokom-backups
# Local copies (optional, default ../backups next to the repo).
# BACKUP_DIR=../backups
# Restore only: file with the private age key, created for the restore and deleted afterwards.
# AGE_IDENTITY=../secrets/age.key
