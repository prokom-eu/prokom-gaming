# prokom-gaming — environment variables (template, draft from the handoff package; finalised in G1).
# Copy to .env and fill in. Never commit .env. Real values live in the password manager
# (entry "prokom-gaming .env lokalny"). Validation: src/lib/env.ts — the app will not start
# if a required variable is missing or invalid.

# PostgreSQL (required). Default matches docker/compose.dev.yml (project prokom-gaming-dev, host port 54321).
DATABASE_URL=postgresql://prokom:prokom@127.0.0.1:54321/prokom_gaming

# Payload secret (required, at least 32 characters, different per environment).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Port of `pnpm dev` and e2e tests (3100 — prokom-web uses 3000/3001).
PORT=3100

# Public address of the site (canonical URLs, sitemap, links in e-mails).
SITE_URL=http://localhost:3100

# Deployment kind: production | staging | local (staging → noindex everywhere).
SITE_ENV=local

# Local admin created by `pnpm seed` (local only; seed refuses to run in production).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Outgoing mail (required). Local: Mailpit from docker/compose.dev.yml (SMTP 127.0.0.1:1026, UI http://localhost:8026).
SMTP_HOST=127.0.0.1
SMTP_PORT=1026
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM_ADDRESS=formularz@example.test
# MAIL_FROM_NAME=PRO-KOM Gaming

# Where inquiry notifications go (required). Production: gaming@pro-kom.eu (to be confirmed by the owner).
INQUIRY_NOTIFY_EMAIL=gaming@example.test

# Margin alarm and price-queue notifications from the panel (ADR-G002 §4).
ALERT_EMAIL=krystian@example.test

# Closed inquiries are deleted this many months after the last status change (ADR-G005, default 24).
# INQUIRY_RETENTION_MONTHS=24

# Upload directory (optional, default: media).
# MEDIA_DIR=media

# --- Server only (docker/compose.prod.yml, compose.staging.yml) ---
# APP_IMAGE_TAG=      # commit SHA in ghcr.io/prokom-eu/prokom-gaming; rollback = previous SHA
# POSTGRES_PASSWORD=
# APP_PORT=3100       # loopback port for the smoke test on the server
