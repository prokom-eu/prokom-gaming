# prokom-gaming — environment variables (template).
# Copy to .env and fill in. Never commit .env. Real values live in the password manager
# (entry "prokom-gaming .env lokalny"). Validation: src/lib/env.ts — the app will not start
# if a required variable is missing or invalid.

# Runtime mode: development | test | production. Next.js sets it automatically for
# `pnpm dev` / `pnpm build`; usually leave it unset locally.
# NODE_ENV=development

# PostgreSQL (required). Default matches docker/compose.dev.yml (project prokom-gaming-dev, host port 54321).
DATABASE_URL=postgresql://prokom:prokom@127.0.0.1:54321/prokom_gaming

# Payload secret (required, at least 32 characters, different per environment).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Port of `pnpm dev` and e2e tests (optional, default 3100 — prokom-web uses 3000/3001).
PORT=3100

# Local admin created by `pnpm seed` (local only; the seed refuses to run when NODE_ENV=production).
# Optional for the app itself — required by the seed and the e2e login test.
# Password: at least 12 characters. Keep the same values on both computers (password manager).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Deployment kind (optional, default: local): production | staging | local.
# staging → noindex everywhere and robots.txt disallows everything (G15; server behind a password, G16).
SITE_ENV=local

# Upload directory (optional, default: media — relative to the app directory, in .gitignore).
# On the server: a Docker volume mounted at /app/media (G16).
# MEDIA_DIR=media

# Outgoing mail (required). Local: Mailpit from docker/compose.dev.yml (SMTP 127.0.0.1:1026, no
# login; mails at http://localhost:8026). Server: SMTP of the mail provider (G16).
SMTP_HOST=127.0.0.1
SMTP_PORT=1026
# true = TLS from the first byte (port 465); false (default) = STARTTLS when offered (587).
# SMTP_SECURE=false
# Login to the SMTP server (optional, both or neither; leave unset for Mailpit).
# SMTP_USER=
# SMTP_PASS=

# Sender of every mail (required): an address in a domain with SPF/DKIM/DMARC (G16).
# On the server: the Gaming mailbox itself (decision 31.10.2026, P3) — confirmations, alarms and
# replies from the panel all go out from it, and SMTP_USER/SMTP_PASS are that mailbox's account,
# so a customer's answer to any of them lands in the same inbox (read by IMAP in P4).
MAIL_FROM_ADDRESS=formularz@example.test
# Display name (optional, default PRO-KOM Gaming).
# MAIL_FROM_NAME=PRO-KOM Gaming

# Public address of the site, no trailing slash: links in e-mails (G6: panel link in the inquiry
# notification), canonical URLs and sitemap (G15). Required in production; locally optional
# (default http://localhost:3100).
SITE_URL=http://localhost:3100

# Where inquiry notifications go (ADR-G005). Required in production — the app will not start
# without it; locally optional (without it only the customer's confirmation is sent).
# Production: gaming@pro-kom.eu (to be confirmed by the owner).
# Must be the same mailbox as MAIL_FROM_ADDRESS (P3): the confirmation's Reply-To is this address,
# and the panel reads customers' answers from that one inbox (IMAP, P4).
INQUIRY_NOTIFY_EMAIL=gaming@example.test

# Margin alarm (ADR-G002 §4.4). Required in production; locally optional (without it: a warning in the log).
ALERT_EMAIL=krystian@example.test

# Pages waiting for the owner's decision (spec. §11–§12): "Gotowe od ręki" (/gotowe) and the
# gift voucher (/bon). Optional; only `1` turns a page on (and its links in the footer and menu).
# Without it the page answers 404. CI e2e turns both on. Static pages read it at build time —
# set it for the image build too (G16).
# FEATURE_READY=1
# FEATURE_VOUCHER=1

# Inquiries with status "lost" or "closed" are deleted this many months after the last status
# change (optional, default 24; ADR-G005, to be confirmed with the privacy policy).
# INQUIRY_RETENTION_MONTHS=24

# --- Server only (docker/compose.prod.yml, compose.staging.yml — G16). Not read by the app. ---
# APP_IMAGE_TAG=      # commit SHA in ghcr.io/prokom-eu/prokom-gaming; rollback = previous SHA
# POSTGRES_PASSWORD=
# APP_PORT=3100       # loopback port for the smoke test on the server
