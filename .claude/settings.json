{
  "permissions": {
    "allow": [
      "Bash(pnpm lint*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm test*)",
      "Bash(pnpm build*)",
      "Bash(pnpm dev*)",
      "Bash(pnpm format*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git fetch*)",
      "Bash(git branch*)",
      "Bash(git switch*)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git merge --no-ff --no-edit origin/develop)",
      "Bash(git push)",
      "Bash(git push -u origin feat/*)",
      "Bash(git push -u origin fix/*)",
      "Bash(git push -u origin chore/*)",
      "Bash(git push -u origin docs/*)",
      "Bash(gh pr create *)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr diff*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(pnpm vitest run *)",
      "Bash(pnpm exec prettier *)",
      "Bash(pnpm prettier *)",
      "Bash(pnpm exec playwright test*)",
      "Bash(pnpm generate:types)",
      "Bash(pnpm generate:importmap)",
      "Bash(pnpm payload migrate)",
      "Bash(pnpm payload migrate:down)",
      "Bash(pnpm payload migrate:status)",
      "Bash(pnpm payload migrate:create *)",
      "Bash(pnpm seed)",
      "mcp__Claude_Browser__find",
      "mcp__Claude_Browser__read_console_messages",
      "mcp__Claude_Browser__preview_logs",
      "mcp__Claude_Browser__read_network_requests",
      "mcp__Claude_Browser__get_page_text",
      "mcp__ccd_pr__get_status"
    ],
    "ask": [
      "Bash(pnpm add*)",
      "Bash(pnpm install*)",
      "Bash(pnpm remove*)",
      "Bash(docker *)",
      "Bash(gh pr merge*)",
      "Bash(gh pr close*)",
      "Bash(gh release*)",
      "Bash(gh workflow run*)",
      "Bash(ssh *)",
      "Bash(scp *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.staging)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.production)",
      "Edit(./.env.staging)",
      "Bash(git push origin main*)",
      "Bash(git push origin develop*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(rm -rf *)",
      "Bash(git push -u origin main*)",
      "Bash(git push -u origin develop*)",
      "Bash(git push --set-upstream origin main*)",
      "Bash(git push --set-upstream origin develop*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/format.mjs"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
